direction: right
title: "Troubleshooting Decision Path" { shape: text; near: top-center; style.font-size: 30 }
symptom: "Symptom" {
  icon: ../icons/terminal.svg
}
logs: "Inspect Logs / PID" {
  icon: ../icons/document.svg
}
deps: "Check Dependencies" {
  icon: ../icons/server.svg
}
cache: "Check Cache / Model" {
  icon: ../icons/code.svg
}
fix: "Targeted Fix" {
  icon: ../icons/lock.svg
}
retry: "Retry" {
  icon: ../icons/video.svg
}
symptom -> logs -> deps -> cache -> fix -> retry
